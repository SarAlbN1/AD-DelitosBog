{
  "name": "presentacion-delitosbog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Presentación de la sustentación final del proyecto AD-DelitosBog",
  "scripts": {
    "datos": "python scripts/preparar_datos.py",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "export:pdf": "npm run build && tsx scripts/export-pdf.ts",
    "verificar": "tsx scripts/verificar-navegacion.ts",
    "guion": "tsx scripts/generar-guion.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "framer-motion": "^14.14.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.82.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.11.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.11",
    "@types/react": "^18.3.32",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.48.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
