/// Una fila por día de la serie, con festivo, día de la semana y año atípico.
table dim_calendario
	lineageTag: 66b085c9-2f24-479e-bf2b-96fab212824f
	dataCategory: Time

	column fecha
		dataType: dateTime
		isKey
		lineageTag: 737f1e95-2a28-49bb-a731-d613eac986bd
		sourceColumn: fecha

	column anio
		dataType: int64
		lineageTag: dbf72fbf-6c7c-46ed-8e9a-3a711b7bf644
		summarizeBy: none
		sourceColumn: anio

	column mes
		dataType: int64
		lineageTag: 977a225c-d1e9-4e80-9ddc-dd08117bb0bc
		summarizeBy: none
		sourceColumn: mes

	column nombre_mes
		dataType: string
		lineageTag: d843a8bf-186b-46c2-a88b-883640847369
		sourceColumn: nombre_mes
		sortByColumn: mes

	column anio_mes
		dataType: string
		lineageTag: 585f418e-5c9b-4dd1-b54b-c493184500a2
		sourceColumn: anio_mes

	column trimestre
		dataType: int64
		lineageTag: d29a3854-e8ea-45af-b898-b9a1172c92ba
		sourceColumn: trimestre

	column dia_del_mes
		dataType: int64
		lineageTag: 8f1e24a5-4529-4b6c-b539-545e2dad28c2
		sourceColumn: dia_del_mes

	column dia_semana_numero
		dataType: int64
		lineageTag: 09a18c2d-9b57-4680-92f3-4ffa60dd061e
		summarizeBy: none
		sourceColumn: dia_semana_numero

	column dia_semana
		dataType: string
		lineageTag: 4ec6e5bd-44e1-458a-ada8-f71145fc86b7
		sourceColumn: dia_semana
		sortByColumn: dia_semana_numero

	column fin_de_semana
		dataType: int64
		lineageTag: 32cbe90d-f05a-4e08-9a5a-fa0051f581a5
		sourceColumn: fin_de_semana

	column festivo
		dataType: int64
		lineageTag: 62f968c9-ff7a-41e5-aa02-c24bf476c6c3
		sourceColumn: festivo

	column vispera_de_festivo
		dataType: int64
		lineageTag: afaf7a4f-164c-477e-9a88-7d4845813e2d
