	column anio_atipico
		dataType: int64
		lineageTag: 913d3adb-f981-47ea-aedf-6f8f8776588f
		sourceColumn: anio_atipico

	column tipo_dia
		dataType: string
		lineageTag: b3182f0c-f7a4-4481-bbac-c17805e55cc1
		sourceColumn: tipo_dia

	partition dim_calendario = m
		mode: import
		source =
				let
				    T = LeerHoja("dim_calendario.csv"),
				    Tipos = Table.TransformColumnTypes(T, {{"fecha", type date}, {"anio", Int64.Type}, {"mes", Int64.Type}, {"nombre_mes", type text}, {"anio_mes", type text}, {"trimestre", Int64.Type}, {"dia_del_mes", Int64.Type}, {"dia_semana_numero", Int64.Type}, {"dia_semana", type text}, {"fin_de_semana", Int64.Type}, {"festivo", Int64.Type}, {"vispera_de_festivo", Int64.Type}, {"quincena", Int64.Type}, {"anio_atipico", Int64.Type}}, "en-US"),
				    Tipo = Table.AddColumn(Tipos, "tipo_dia", each if [festivo] = 1 then "Festivo" else if [fin_de_semana] = 1 then "Fin de semana" else "Laborable", type text)
				in
				    Tipo

