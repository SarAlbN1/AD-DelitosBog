ref table fact_poblacion
ref table fact_fuentes_mensual
ref table dim_fuente
ref table fact_comparadores
ref table fact_validacion_rodante
ref table qa_embudo
ref table qa_nulos
ref table qa_atipicos
ref table qa_reglas
ref table geo_localidades
ref table dim_localidad
ref table Medidas

ref cultureInfo en-US

